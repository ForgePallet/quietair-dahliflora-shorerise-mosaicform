#!/usr/bin/env node
import { createRequire } from "node:module"; const require = createRequire(import.meta.url);
import{chmodSync,copyFileSync,lstatSync,mkdirSync,mkdtempSync,readdirSync,readFileSync,rmSync,writeFileSync}from"node:fs";import{tmpdir}from"node:os";import{join}from"node:path";import{spawnSync}from"node:child_process";var OPERATION_ALIAS=/^x[a-z2-7]{10}$/u;var REVISION=/^[0-9a-f]{40}$/u;async function runArtifactBootstrap(aliases,host=defaultArtifactBootstrapHost()){const values=environmentValues(aliases,host.environment);if(values===void 0)return"setup failed";let root;try{root=host.temporaryDirectory()}catch{return"setup failed"}let result2;try{result2=await runInTemporaryRoot(aliases,values,root,host)}catch{result2="setup failed"}try{host.removeTree(root)}catch{ignoreCleanupFailure()}return result2}function ignoreCleanupFailure(){}function environmentValues(aliases,environment){const storeRef=nonempty(environment[aliases.storeRefEnv]);const storeRevision=nonempty(environment[aliases.storeRevEnv]);const storeToken=nonempty(environment[aliases.storeTokenEnv]);const operation=nonempty(environment[aliases.operationEnv]);const outputs=environment[aliases.outputsEnv];if(storeRef===void 0||storeRevision===void 0||storeToken===void 0||operation===void 0||outputs===void 0||!REVISION.test(storeRevision)||!OPERATION_ALIAS.test(operation)||!validOutputs(outputs))return void 0;return{storeRef,storeRevision,storeToken,operation}}async function runInTemporaryRoot(aliases,values,root,host){const runtime=join(root,"r");const repository=join(root,"q");const log=join(root,"l");const output=join(root,"o");host.ensureDirectory(runtime);host.ensureDirectory(repository);const environment={...definedEnvironment(host.environment),GH_TOKEN:values.storeToken};const git=(...arguments_)=>host.run({argv:["git","-C",repository,...arguments_],environment});if(git("init","--quiet")!==0||git("config","credential.helper","")!==0||git("config","credential.https://github.com.helper","!gh auth git-credential")!==0||git("remote","add","origin",`https://github.com/${values.storeRef}.git`)!==0||git("sparse-checkout","init","--cone")!==0||git("sparse-checkout","set",`x/${values.operation}`)!==0)return"setup failed";const transportEnvironment={...environment,GIT_TERMINAL_PROMPT:"0"};let fetched=false;for(let attempt=0;attempt<4;attempt+=1){fetched=host.run({argv:["git","-C",repository,"fetch","--quiet","--no-tags","--depth=1","--filter=blob:none","origin",values.storeRevision],environment:transportEnvironment,logPath:log})===0;if(fetched)break;await host.sleep(2e3)}if(!fetched||host.run({argv:["git","-C",repository,"checkout","--quiet","--detach","FETCH_HEAD"],environment:transportEnvironment,logPath:log})!==0||host.run({argv:["git","-C",repository,"rev-parse","HEAD"],environment:transportEnvironment,logPath:log,stdoutPath:join(root,"v")})!==0||host.readFile(join(root,"v")).trimEnd()!==values.storeRevision)return"setup failed";const source=join(repository,"x",values.operation);const files=host.listRegularFiles(source);if(files===void 0||files.length===0)return"setup failed";for(const name of files){const destination=join(runtime,name);host.copyFile(join(source,name),destination);host.chmod(destination,384)}const executable=join(runtime,"x");host.chmod(executable,448);const capsuleEnvironment={...environment,[aliases.outputFileEnv]:output};return host.run({argv:[executable],environment:capsuleEnvironment,logPath:log,combineOutput:true})===0?"success":"run failed"}function nonempty(value){return value===void 0||value.length===0?void 0:value}function validOutputs(value){return value.length===0||value.split(",").every(alias=>OPERATION_ALIAS.test(alias))}function definedEnvironment(environment){return Object.fromEntries(Object.entries(environment).filter(entry=>entry[1]!==void 0))}function defaultArtifactBootstrapHost(){return{environment:process.env,temporaryDirectory:()=>mkdtempSync(join(tmpdir(),"ciwf-bootstrap-")),ensureDirectory:path=>{mkdirSync(path,{recursive:true})},run:command=>runCommand(command),sleep:async milliseconds=>new Promise(resolve=>{setTimeout(resolve,milliseconds)}),readFile:path=>readFileSync(path,"utf8"),listRegularFiles:path=>{try{const entries=readdirSync(path);return entries.every(entry=>lstatSync(join(path,entry)).isFile())?entries:void 0}catch{return void 0}},copyFile:(source,destination)=>{copyFileSync(source,destination)},chmod:(path,mode)=>{chmodSync(path,mode)},removeTree:path=>{rmSync(path,{recursive:true,force:true})}}}function runCommand(command){const[executable,...arguments_]=command.argv;if(executable===void 0)return 1;const result2=spawnSync(executable,arguments_,{env:command.environment,encoding:"utf8",stdio:command.logPath===void 0&&command.stdoutPath===void 0?["ignore","inherit","inherit"]:["ignore","pipe","pipe"]});const stdout=typeof result2.stdout==="string"?result2.stdout:"";const stderr=typeof result2.stderr==="string"?result2.stderr:"";if(command.stdoutPath!==void 0)writeFileSync(command.stdoutPath,stdout);if(command.logPath!==void 0)writeFileSync(command.logPath,command.combineOutput===true?`${stdout}${stderr}`:stderr);return result2.status??1}var result=await runArtifactBootstrap({storeRefEnv:"x7azqugjkgv",storeRevEnv:"xvpsiqzgh3y",storeTokenEnv:"xfvgehes7wt",operationEnv:"xxzdj6v3skd",outputsEnv:"xlamdnxbo7s",outputFileEnv:"xoyxncjstzr"});if(result!=="success"){process.stderr.write(`${result}
`);process.exitCode=1}
